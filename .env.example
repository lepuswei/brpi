# Local development (optional)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production example for https://meddemo.org/brpi/
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=meddemo.org,www.meddemo.org
# DJANGO_FORCE_SCRIPT_NAME=/brpi
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meddemo.org,https://www.meddemo.org
# DJANGO_SECURE_SSL_REDIRECT=False
# Generate SECRET_KEY on the server with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
